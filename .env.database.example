# Copy to .env.database.local. Keep passwords private; never use VITE_ variables.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=finagenticai
PGUSER=finagenticai_app
PGPASSWORD=replace-with-your-application-database-password
# For initial database/role creation only; never sent to the browser.
PGADMIN_USER=postgres
PGADMIN_PASSWORD=replace-with-your-postgres-administrator-password
POSTGRES_IMAGE=postgres@sha256:eee6c6e1b0894fa4fe0075eb054af9fd1cf39a35321c2d4110626cfe506411fb
